{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Worker de solo activos: no hay `main` porque no hace falta código, Cloudflare sirve
  // el `dist` de Angular directamente.
  //
  // NO HAY BLOQUE `env`, Y ES A PROPÓSITO. Con un solo ambiente, un `env` obliga a que
  // cada despliegue lleve `--env <nombre>`, y el día que se olvida `wrangler deploy`
  // crea un Worker aparte sin rutas: el build queda en verde, el sitio no cambia y no
  // hay nada que se vea roto. Ya pasó una vez con Workers Builds. Sin `env`, el comando
  // por defecto es el correcto y no hay nada que olvidar.
  //
  // El nombre tiene que coincidir con el del Worker en el dashboard o el build de git
  // falla. Si algún día hace falta un segundo ambiente, ver `docs/despliegue.md`.
  "name": "maquinaria-frontend",
  "compatibility_date": "2026-09-01",

  // Sin subdominio `workers.dev`: sería una copia pública de la app en una URL que nadie
  // vigila y que se indexa igual que el dominio bueno.
  "workers_dev": false,

  // El `browser` lo pone el builder `application` de Angular: `dist/<proyecto>/browser`.
  "assets": {
    "directory": "./dist/maquinaria-frontend/browser",
    // Angular resuelve las rutas en el cliente, así que cualquier ruta que no sea un
    // archivo tiene que devolver `index.html` en lugar de 404.
    "not_found_handling": "single-page-application",
  },

  // Rutas y no dominios personalizados: un dominio personalizado se ejecuta DESPUÉS de
  // las rutas, así que el comodín se lo tragaría. El comodín es lo que hace funcionar el
  // subdominio por empresa (`bajio.maqvia.com`) sin dar de alta cada una a mano, y exige
  // el registro DNS comodín proxied. Ver README.
  "routes": [
    { "pattern": "maqvia.com/*", "zone_name": "maqvia.com" },
    { "pattern": "*.maqvia.com/*", "zone_name": "maqvia.com" },
  ],
}
